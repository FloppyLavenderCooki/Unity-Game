:root {
}

Button {
    font-size: 15px;
    height: 1px;
    min-height: 1px;
    max-height: 1px;
    padding-top: 17px;
    padding-right: 15px;
    padding-bottom: 13px;
    padding-left: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Main%20Pixel%20Font%20SDF%201.asset?fileID=11400000&guid=d048a25d2392aab43a0774303d14cf31&type=2#Main Pixel Font SDF 1");
    -unity-font-style: bold;
    background-color: rgb(0, 108, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-top: 2px;
    margin-right: 5px;
    margin-bottom: 1px;
    margin-left: 5px;
    letter-spacing: 1px;
}

Button:hover {
    background-color: rgb(0, 97, 229);
}

Button.selected {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    padding-top: 16px;
    padding-right: 14px;
    padding-bottom: 12px;
    padding-left: 14px;
}

Button:active {
    background-color: rgb(0, 86, 204);
}
